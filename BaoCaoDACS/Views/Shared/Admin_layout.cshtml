@using Microsoft.AspNetCore.Identity


<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADMIN - @ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/adminLayout.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="side-bar d-flex flex-column justify-content-between h-100 p-3">
        <div>
            <h3>📖 Trang Admin</h3>
            <a class="btn btn-outline-dark w-100 mb-2" asp-area="Admin" asp-action="Index" asp-controller="NguoiDung">Quản lý Người dùng</a>
            <a class="btn btn-outline-dark w-100 mb-2" asp-area="Admin" asp-action="Index" asp-controller="GiaiDau">Quản lý Giải Đấu</a>
            <a class="btn btn-outline-dark w-100 mb-2" asp-area="Admin" asp-action="Index" asp-controller="TranDau">Quản lý Trận Đấu</a>
            <a class="btn btn-outline-dark w-100 mb-2" asp-area="Admin" asp-action="Index" asp-controller="KetQua">Quản lý Ket Qua</a>

        </div>

        <div>
            <a class=" btn btn-secondary w-100 mb-2 text-center" asp-area="" asp-action="Index" asp-controller="Home">Về Trang Chủ</a>

            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="btn btn-danger w-100">Đăng xuất</button>
            </form>
        </div>
    </div>
    <div class="overlay"></div>
    <div class="my-nav-bar">
        <div id="sideBarToggler">
            ☰
        </div>
        <div>
            <p class="p-0 m-0 d-inline"></p>
        </div>
    </div>
    <div class="contents">
        @RenderBody()
    </div>

    <!-- jQuery first -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap 5 Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/adminLayout.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
