<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="vctThemeColor" name="theme-color" content="#1c1a16" />
    <title>@ViewData["Title"] - VCT Score</title>
    <script>
        (() => {
            const storageKey = "vct-theme";
            let theme = "dark";
            try {
                const savedTheme = localStorage.getItem(storageKey);
                theme = savedTheme === "light" || savedTheme === "dark"
                    ? savedTheme
                    : (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
            } catch {
                theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
            }
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BaoCaoDACS.styles.css" asp-append-version="true" />
    <link href="~/css/layout.css" rel="stylesheet" />
    <link href="~/css/vct-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/vct-theme-mobile.css" rel="stylesheet" asp-append-version="true" media="(max-width: 1199.98px)" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="vct-public">
    <header class="header">
        <div class="container-fluid header-container d-flex align-items-center justify-content-between" style="max-width: 1480px;">
            <a class="vct-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="VCT Score - Trang chủ">
                <span class="vct-seal vct-seal--brand" aria-hidden="true">V</span>
                <span class="vct-brand__copy">
                    <span class="vct-brand__name">VCT Score</span>
                    <span class="vct-brand__sub">Võ cổ truyền</span>
                </span>
            </a>
            <nav class="navbar navbar-expand-xl navbar-dark">
                <div class="container-fluid">

                    <div class="collapse navbar-collapse" id="navbarMenu">
                        <ul class="navbar-nav ms-auto mb-2 mb-xl-0">
                            <li class="nav-item">
                                <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#GiaDau">Giải đấu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="LichThidau">Lịch thi đấu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#Ketquamoinhat">Kết quả</a>
                            </li>
                            <li class="nav-item">
                                @if (User?.Identity?.IsAuthenticated ?? false)
                                {
                                    <button class="nav-link" id="chamDiemBtn" onclick="hienThiDanhSachGiaiDau()">Chấm điểm</button>
                                }
                                else
                                {
                                    <a asp-area="Identity" asp-page="/Account/Login" class="nav-link" title="Vui lòng đăng nhập để chấm điểm">Chấm điểm</a>
                                }
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="#">Tin tức</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <div class="vct-header-actions">
                <partial name="_LoginPartial" />
                <button type="button" class="vct-theme-toggle" data-theme-toggle aria-label="Chuyển sang giao diện sáng" title="Chuyển sang giao diện sáng">
                    <i class="bi bi-sun-fill vct-theme-toggle__sun" aria-hidden="true"></i>
                    <i class="bi bi-moon-stars-fill vct-theme-toggle__moon" aria-hidden="true"></i>
                </button>
                <button class="navbar-toggler vct-mobile-nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
                        aria-controls="navbarMenu" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </div>
            <div id="real-time-clock" class="ms-2" style="color: white; font-size: 0.8rem; font-weight: bold;"></div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Giới thiệu</h3>
                    <p>Hệ thống chấm điểm Võ Cổ Truyền chuyên nghiệp, hiện đại nhất hiện nay.</p>
                    <div class="social-icons">
                        <a href="#" class="social-icon">f</a>
                        <a href="#" class="social-icon">in</a>
                        <a href="#" class="social-icon">yt</a>
                    </div>
                </div>

                <div class="footer-section">
                    <h3>Liên kết</h3>
                    <ul>
                        <li><a href="#">Trang chủ</a></li>
                        <li><a href="#">Giải đấu</a></li>
                        <li><a href="#">Lịch thi đấu</a></li>
                        <li><a href="#">Kết quả</a></li>
                        <li><a href="#">Thống kê</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>Hỗ trợ</h3>
                    <ul>
                        <li><a href="#">Hướng dẫn sử dụng</a></li>
                        <li><a href="#">Câu hỏi thường gặp</a></li>
                        <li><a href="#">Liên hệ</a></li>
                        <li><a href="#">Báo lỗi</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>Liên hệ</h3>
                    <p>Email: info@vctscore.vn</p>
                    <p>Điện thoại: (84) 91 220 9095</p>
                    <p>Địa chỉ: 123 Nguyễn Văn Linh, TP HCM</p>
                </div>
            </div>

            <div class="copyright">
                &copy; 2025 Hệ thống Chấm điểm Võ Cổ Truyền. Đã đăng ký bản quyền.
            </div>

            <div id="tournamentModal" class="modal-overlay">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5>Chọn trận đấu</h5>
                    </div>
                    <div class="modal-body">
                        <select class="form-select" data-vct-select>
                            <option value="">Đang tải dữ liệu...</option>
                        </select>
                        <div class="loading-spinner"></div>
                        <div class="button-group mt-3">
                            <button class="btn btn-confirm">Xác nhận</button>
                            <button class="btn btn-cancel">Hủy bỏ</button>
                        </div>
                    </div>
                </div>
            </div>

            <df-messenger intent="WELCOME"
                          chat-title="dacs"
                          agent-id="794bf910-6903-46cc-87a0-f7bf47471235"
                          language-code="en"></df-messenger>
	</footer>

    <!-- jQuery first, then Bootstrap Bundle with Popper -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Layout.js" asp-append-version="true"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/custom-select.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    // ... (giữ nguyên toàn bộ khối script chấm điểm phía dưới, không có conflict)
</script>
