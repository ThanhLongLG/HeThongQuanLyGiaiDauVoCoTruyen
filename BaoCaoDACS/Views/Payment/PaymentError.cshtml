@{
    ViewData["Title"] = "Lỗi thanh toán";
}

<link href="~/css/Payment.css" rel="stylesheet" asp-append-version="true" />

<section class="vct-payment-page vct-payment-status-page" aria-labelledby="payment-error-title">
    <article class="vct-payment-status vct-payment-status--failed">
        <span class="vct-payment-status__icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
        <div class="vct-page-kicker">Giao dịch gián đoạn</div>
        <h1 id="payment-error-title">Không thể thanh toán</h1>
        <p>@(ViewBag.ErrorMessage ?? "Đã có lỗi xảy ra trong quá trình xử lý giao dịch.")</p>

        <div class="vct-payment-status__actions">
            <a class="vct-payment-secondary" href="javascript:history.back()">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Quay lại
            </a>
            <a class="vct-payment-primary" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house" aria-hidden="true"></i>
                Về trang chủ
            </a>
        </div>
    </article>
</section>
