@{
    ViewData["Title"] = "Home Page";
}
@{
    var loginUrl = Url.Page("/Account/Login", new { area = "Identity" });
    var currentUserEmail = User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? User?.Identity?.Name
        ?? string.Empty;
}
<script>
    // Razor sẽ in ra true hoặc false trực tiếp
    const isAuthenticated = @((User?.Identity?.IsAuthenticated ?? false).ToString().ToLower());
    const loginUrl = "@loginUrl";
</script>


<!-- Hero -->
<section class="vct-hero">
    <div class="container vct-hero__inner">
        <div class="vct-hero__content">
            <div class="vct-eyebrow">Bản lĩnh Việt · Điểm số minh bạch</div>
            <h1>Hệ thống Chấm điểm Võ Cổ Truyền</h1>
            <p>Nền tảng quản lý giải đấu và chấm điểm trực tuyến chính xác, minh bạch — nơi tinh thần thượng võ Việt Nam gặp một hệ thống vận hành hiện đại.</p>
            <button class="vct-btn vct-btn--primary" id="explore-btn">
                Khám phá ngay <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
        <span class="vct-hero__seal" aria-hidden="true">V</span>
    </div>
</section>

<!-- Main Content -->
<main class="main-content container">
    <section id="GiaDau">
        <div class="vct-page-kicker">Sự kiện nổi bật</div>
        <h2 class="section-title">Giải đấu sắp diễn ra</h2>
        <div class="tournaments" id="tournaments">
            <!-- Giải đấu 1 -->
            
           
        </div>
          
    </section>

    <!-- Lịch -->
    <section class="calendar-section">
        <div class="calendar-header">
            <h2 class="section-title" style="margin-bottom: 0;">Lịch thi đấu</h2>
            <div class="month-selector">
                <button class="month-nav" id="prev-month">←</button>
                <h3 id="current-month"></h3>
                <button class="month-nav" id="next-month">→</button>
            </div>
        </div>
        <div class="calendar-grid">
            <!-- Day names -->
            <div class="day-name">CN</div>
            <div class="day-name">T2</div>
            <div class="day-name">T3</div>
            <div class="day-name">T4</div>
            <div class="day-name">T5</div>
            <div class="day-name">T6</div>
            <div class="day-name">T7</div>
            <!-- Calendar days will be dynamically rendered here -->
        </div>
    </section>
  

    <!-- Kết quả mới nhất -->
    <section class="results-section" id="Ketquamoinhat">
        <h2 class="section-title">Kết Quả Mới Nhất</h2>
        <table class="results-table" id="scoreTable">
            <thead>
                <tr>
                    <th>Giải đấu</th>
                    <th>Loại hình thi đấu</th>
                    <th>Võ sinh</th>
                    <th>CLB/Đội</th>
                    <th>Điểm</th>
                    <th>Ngày</th>
                </tr>
            </thead>
            <tbody>
                
                <tr>
                    <td>Giải Trẻ Toàn Quốc</td>
                    <td>Phạm Thị D</td>
                    <td>CLB Cần Thơ</td>
                    <td class="score">9.0</td>
                    <td>08/03/2025</td>
                </tr>
            </tbody>
        </table>
    </section>
</main>





@* Thedangkygiai *@
<div id="register-tournament-modal" class="modal" data-tournament-id="">
    <div class="modal-content vct-registration-card" role="dialog" aria-modal="true" aria-labelledby="registration-title">
        <button type="button" class="modal-close vct-registration-close" aria-label="Đóng form đăng ký">&times;</button>
        <div class="vct-registration-card__header">
            <span class="vct-seal vct-seal--brand" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
            <div>
                <div class="vct-page-kicker">Thông tin võ sinh</div>
                <h2 id="registration-title">Đăng ký tham dự</h2>
                <p>Điền thông tin bên dưới để tham gia giải đấu.</p>
            </div>
        </div>
        <form id="registrationForm" class="vct-registration-form" onsubmit="return false;">
            <div class="vct-registration-grid">
                <div class="form-group">
                    <label for="register-name">Họ và tên <span aria-hidden="true">*</span></label>
                    <input type="text" id="register-name" autocomplete="name" placeholder="Nguyễn Văn A" required>
                </div>
                <div class="form-group">
                    <label for="register-email">Email tài khoản</label>
                    <input type="email" id="register-email" value="@currentUserEmail" autocomplete="email" readonly aria-readonly="true" title="Email được lấy từ tài khoản đang đăng nhập">
                    <small class="vct-field-help"><i class="bi bi-lock-fill" aria-hidden="true"></i> Tài Khoản email hiện tại</small>
                </div>
                <div class="form-group">
                    <label for="register-phone">Số điện thoại <span aria-hidden="true">*</span></label>
                    <input type="tel" id="register-phone" autocomplete="tel" inputmode="tel" placeholder="09xx xxx xxx" required>
                </div>
                <div class="form-group">
                    <label for="register-club">Câu lạc bộ</label>
                    <input type="text" id="register-club" autocomplete="organization" placeholder="Tên CLB hoặc đơn vị">
                </div>
            </div>
            <p class="vct-registration-note"><i class="bi bi-shield-check" aria-hidden="true"></i> Thông tin được dùng để lập danh sách thi đấu.</p>
            <button type="submit" class="vct-btn vct-registration-submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Đăng ký tham dự</button>
        </form>
    </div>
</div>


<script>
    fetch('/Home/TopScores')
    .then(response => response.json())
    .then(data => {
        const tbody = document.querySelector('#scoreTable tbody');
        tbody.innerHTML = '';
        data.forEach(item => {
            const row = `
                <tr>
                    <td>${item.giai}</td>
                    <td>${item.loaiHinhThiDau}</td>
                    <td>${item.vanDongVien}</td>
                    <td>${item.clb}</td>
                    <td class="score">${item.diem}</td>
                    <td>${item.ngayDau}</td>
                </tr>
            `;
            tbody.innerHTML += row;
        });
    });
   
</script>
