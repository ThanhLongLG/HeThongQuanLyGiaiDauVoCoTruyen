@model BaoCaoDACS.Models.Participant

@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<link href="~/css/Profile.css" rel="stylesheet" asp-append-version="true" />

<section class="vct-profile-page" aria-labelledby="profile-page-title">
    <div class="vct-profile-heading">
        <div>
            <div class="vct-page-kicker">Thông tin võ sinh</div>
            <h1 id="profile-page-title">Chỉnh sửa hồ sơ</h1>
            <p>Cập nhật thông tin cá nhân dùng trong danh sách và các giải đấu.</p>
        </div>
        <a class="vct-profile-back" asp-controller="Home" asp-action="Index">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Về trang chủ
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="vct-profile-alert vct-profile-alert--success" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }

    @if (Model == null)
    {
        <div class="vct-profile-empty">
            <span class="vct-seal" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
            <h2>Chưa có hồ sơ võ sinh</h2>
            <p>Bạn cần đăng ký tham gia một giải đấu trước khi chỉnh sửa hồ sơ.</p>
            <a class="vct-profile-submit" asp-controller="Home" asp-action="Index" asp-fragment="GiaDau">
                <i class="bi bi-trophy" aria-hidden="true"></i>
                Xem giải đấu
            </a>
        </div>
    }
    else
    {
        <form class="vct-profile-card needs-validation"
              asp-controller="Home"
              asp-action="Profile"
              method="post"
              novalidate>
            <div class="vct-profile-card__header">
                <span class="vct-seal" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
                <div>
                    <h2>Thông tin cá nhân</h2>
                    <p>Các trường có dấu <span>*</span> là bắt buộc.</p>
                </div>
            </div>

            <div class="vct-profile-card__body">
                <div asp-validation-summary="ModelOnly" class="vct-profile-validation" role="alert"></div>
                <input asp-for="ParticipantID" type="hidden" />

                <div class="vct-profile-grid">
                    <div class="vct-profile-field">
                        <label asp-for="FullName">Họ và tên <span>*</span></label>
                        <div class="vct-profile-input">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <input asp-for="FullName" autocomplete="name" placeholder="Nguyễn Văn A" required />
                        </div>
                        <span asp-validation-for="FullName" class="vct-profile-field-error"></span>
                    </div>

                    <div class="vct-profile-field">
                        <label asp-for="Club">Câu lạc bộ <span>*</span></label>
                        <div class="vct-profile-input">
                            <i class="bi bi-shield" aria-hidden="true"></i>
                            <input asp-for="Club" autocomplete="organization" placeholder="Tên câu lạc bộ" required />
                        </div>
                        <span asp-validation-for="Club" class="vct-profile-field-error"></span>
                    </div>

                    <div class="vct-profile-field">
                        <label asp-for="email">Email</label>
                        <div class="vct-profile-input">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <input asp-for="email" type="email" autocomplete="email" placeholder="ten@example.com" />
                        </div>
                        <span asp-validation-for="email" class="vct-profile-field-error"></span>
                    </div>

                    <div class="vct-profile-field">
                        <label asp-for="sdt">Số điện thoại</label>
                        <div class="vct-profile-input">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                            <input asp-for="sdt" type="tel" autocomplete="tel" inputmode="tel" placeholder="09xx xxx xxx" />
                        </div>
                        <span asp-validation-for="sdt" class="vct-profile-field-error"></span>
                    </div>

                    <div class="vct-profile-field">
                        <label asp-for="tuoi">Tuổi</label>
                        <div class="vct-profile-input">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <input asp-for="tuoi" type="number" inputmode="numeric" min="1" max="120" placeholder="18" />
                        </div>
                        <span asp-validation-for="tuoi" class="vct-profile-field-error"></span>
                    </div>

                    <div class="vct-profile-field">
                        <label asp-for="Diachi">Địa chỉ</label>
                        <div class="vct-profile-input">
                            <i class="bi bi-geo-alt" aria-hidden="true"></i>
                            <input asp-for="Diachi" autocomplete="street-address" placeholder="Địa chỉ hiện tại" />
                        </div>
                        <span asp-validation-for="Diachi" class="vct-profile-field-error"></span>
                    </div>

                    <div class="vct-profile-field">
                        <label asp-for="ChieuCao">Chiều cao (cm)</label>
                        <div class="vct-profile-input">
                            <i class="bi bi-arrows-vertical" aria-hidden="true"></i>
                            <input asp-for="ChieuCao" type="number" inputmode="decimal" min="1" step="0.1" placeholder="170" />
                        </div>
                        <span asp-validation-for="ChieuCao" class="vct-profile-field-error"></span>
                    </div>

                    <div class="vct-profile-field">
                        <label asp-for="CanNang">Cân nặng (kg)</label>
                        <div class="vct-profile-input">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            <input asp-for="CanNang" type="number" inputmode="decimal" min="1" step="0.1" placeholder="60" />
                        </div>
                        <span asp-validation-for="CanNang" class="vct-profile-field-error"></span>
                    </div>
                </div>
            </div>

            <div class="vct-profile-card__footer">
                <a class="vct-profile-cancel" asp-controller="Home" asp-action="Index">Hủy</a>
                <button type="submit" class="vct-profile-submit">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    Lưu thay đổi
                </button>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            "use strict";
            const form = document.querySelector(".vct-profile-card.needs-validation");
            if (!form) return;

            form.addEventListener("submit", event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add("was-validated");
            });
        })();
    </script>
}
