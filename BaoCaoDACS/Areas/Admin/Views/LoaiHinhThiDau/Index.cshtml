@model IEnumerable<BaoCaoDACS.Models.LoaiHinhThiDau>
@{
    ViewData["Title"] = "Quản lý loại hình thi đấu";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent">
            <li class="breadcrumb-item"><a href="/Admin/TrangQL" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Loại hình thi đấu</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Danh sách loại hình thi đấu</h5>
            <div>
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Thêm mới
                </a>
                <a asp-action="CreateQuickData" class="btn btn-success btn-sm">
                    <i class="bi bi-database-add me-1"></i> Tạo dữ liệu mẫu
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên loại hình</th>
                            <th>Môn võ</th>
                            <th>Số giải đấu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.LoaiHinhThiDauId</td>
                                <td>@item.Name</td>
                                <td>@item.MonVo</td>
                                <td>@(item.tournament != null ? item.tournament.Count : 0)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info m-3">
                    <i class="bi bi-info-circle-fill me-2"></i> Chưa có dữ liệu loại hình thi đấu
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-area="Admin" asp-controller="GiaiDau" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại giải đấu
        </a>
    </div>
</div>
