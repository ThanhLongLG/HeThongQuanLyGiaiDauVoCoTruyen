@model BaoCaoDACS.Models.Socre
@{
    ViewData["Title"] = "Thêm Kết Quả Mới";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}

<head>
    <link href="~/css/admin.css" rel="stylesheet" />

        <link href="~/css/site.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
   
</head>

<div class="container-fluid py-4">
    <nav class="mt-2 mb-4" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active text-white">Danh sách Kết Quả</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-trophy me-2"></i>Thêm kết quả mới
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@modelError.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }
                    <form asp-action="Add" method="post">
                        <div class="form-group">
                            <label>Giải Đấu</label>
                            <select id="TournamentId" class="form-control">
                                <option value="">-- Chọn giải đấu --</option>
                                @foreach (var item in ViewBag.Tournaments as IEnumerable<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Trận đấu</label>
                            <select asp-for="MatchId" id="MatchId" class="form-control">
                                <option value="">-- Chọn trận đấu --</option>
                                @foreach (var item in ViewBag.Matches as IEnumerable<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Vận động viên</label>
                            <select asp-for="ParticipantId" id="ParticipantId" class="form-control">
                                <option value="">-- Chọn vận động viên --</option>
                                @foreach (var item in ViewBag.Participants as IEnumerable<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>

                        </div>
                        <div class="mt-3" id="suggestBox" style="display:none;">
                            <label class="form-label fw-bold">Gợi ý đối thủ phù hợp</label>
                            <div class="list-group" id="suggestList"></div>
                            <small class="text-muted d-block mt-2" id="suggestHint"></small>
                        </div>

                        <input type="hidden" id="firstParticipantId" value="@ViewBag.FirstParticipantId" />
                        <input type="hidden" id="matchId" value="@ViewBag.MatchId" />


                      
                        <div class="form-group">
                            <label asp-for="Diem">Điểm</label>
                            <input asp-for="Diem" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="KietQua">Kết quả</label>
                            <input asp-for="KietQua" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Kq">Kết quả bằng số với 1 là thắng 0 là thua</label>
                            <input asp-for="Kq" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-primary">Thêm Điểm Số</button>
                    </form>
                  
                   
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>

          $("#TournamentId").change(function () {
            var tid = $(this).val();
            $('#MatchId').load('/Admin/KetQua/GetMatchesByTournament?tournamentId=' + tid, function () {
                if ($('#MatchId option').length === 0) {
                    $('#MatchId').append('<option value="">-- Giải đấu này chưa có trận đấu --</option>');
                }
            });
            $("#ParticipantId").load('/Admin/KetQua/GetParticipantsByTournament?tournamentId=' + tid,function () {
                if ($('#ParticipantId option').length === 0) {
                    $('#ParticipantId').append('<option value="">-- Chưa Có người tham gia --</option>');
                }
              });
        });
 
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')

            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }

                    form.classList.add('was-validated')
                }, false)
            })
        })()


        //goi y ket qua
                    document.addEventListener("DOMContentLoaded", async () => {
            const firstId = document.getElementById("firstParticipantId")?.value;
            const matchId = document.getElementById("matchId")?.value;

            // Chỉ gợi ý khi đã có VĐV #1
            if (!firstId || !matchId) return;

            const box = document.getElementById("suggestBox");
            const list = document.getElementById("suggestList");
            const hint = document.getElementById("suggestHint");

            try {
                const url = `/Admin/KetQua/SuggestSecondParticipant?matchId=${encodeURIComponent(matchId)}&firstParticipantId=${encodeURIComponent(firstId)}&take=8`;
                const res = await fetch(url);

                if (!res.ok) throw new Error("Không tải được gợi ý đối thủ");
                const data = await res.json();

                if (!data || data.length === 0) {
                    hint.textContent = "Không có đối thủ phù hợp (hoặc giải chỉ có 1 người).";
                    box.style.display = "block";
                    return;
                }

                // Render danh sách gợi ý
                list.innerHTML = data.map(x => `
                    <button type="button" class="list-group-item list-group-item-action"
                            data-id="${x.participantId}">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="fw-semibold">${x.fullName} (${x.club ?? ""})</div>
                                <small class="text-muted">
                                    Elo: ${x.rating} • Kg: ${x.canNang ?? ""} • Cm: ${x.chieuCao ?? ""} • Tuổi: ${x.tuoi ?? ""}
                                </small>
                            </div>
                            <small class="text-muted">${(x.matchScore ?? 0).toFixed(2)}</small>
                        </div>
                        <small class="text-muted">${x.reason ?? ""}</small>
                    </button>
                `).join("");

                box.style.display = "block";

                // Khi click 1 gợi ý -> auto chọn vào dropdown ParticipantId
                list.querySelectorAll("button[data-id]").forEach(btn => {
                    btn.addEventListener("click", () => {
                        const pid = btn.getAttribute("data-id");
                        const select = document.querySelector("select[name='ParticipantId'], #ParticipantId");
                        if (select) {
                            select.value = pid;
                            select.dispatchEvent(new Event("change"));
                        }
                    });
                });

            } catch (e) {
                console.error(e);
                hint.textContent = "Có lỗi khi tải gợi ý.";
                box.style.display = "block";
            }
        });
    </script>
}
