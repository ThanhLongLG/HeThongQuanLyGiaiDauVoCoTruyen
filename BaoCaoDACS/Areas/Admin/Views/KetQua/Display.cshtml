@model Socre
@{
    Layout = "~/Views/Shared/Admin_layout.cshtml";
    ViewData["Title"] = "Display";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<nav class="mt-2 mb-4" aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item active text-white">Danh sách Kết Quả</li>
    </ol>
</nav>
<div class="container">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-chart-bar me-2"></i>Chi tiết Điểm số và Kết quả
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th class="bg-light text-primary">
                                    <i class="fas fa-hashtag me-2"></i>Mã Điểm
                                </th>
                                <td>@Model.ScoreId</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-primary">
                                    <i class="fas fa-trophy me-2"></i>Điểm số
                                </th>
                                <td class="fw-bold">
                                    @(Model.Diem.HasValue 
                                        ? Model.Diem.Value.ToString("F2") 
                                        : "Chưa có điểm")
                                </td>
                            </tr>
                            <tr>
                                <th class="bg-light text-primary">
                                    <i class="fas fa-check-circle me-2"></i>Kết quả
                                </th>
                                <td>
                                    @{
                                        string resultBadgeClass = "bg-secondary";
                                        string resultText = "Chưa xác định";

                                        if (Model.Kq.HasValue)
                                        {
                                            switch (Model.Kq.Value)
                                            {
                                                case 1:
                                                    resultBadgeClass = "bg-success";
                                                    resultText = "Thắng";
                                                    break;
                                                case 0:
                                                    resultBadgeClass = "bg-danger";
                                                    resultText = "Thua";
                                                    break;
                                                case 2:
                                                    resultBadgeClass = "bg-warning";
                                                    resultText = "Hòa";
                                                    break;
                                            }
                                        }
                                    }
                                    <span class="badge @resultBadgeClass">@resultText</span>
                </td>
                            </tr>
                            <tr>
                                <th class="bg-light text-primary">
                                    <i class="fas fa-comment me-2"></i>Kết quả chi tiết
                                </th>
                                <td>
                                    @(string.IsNullOrEmpty(Model.KietQua) 
                                        ? "Không có thông tin chi tiết" 
                                        : Model.KietQua)
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h6 class="mb-0 text-primary">
                                <i class="fas fa-star me-2"></i>Đánh giá
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (string.IsNullOrEmpty(Model.Danhgia))
                            {
                                <div class="alert alert-info text-center" role="alert">
                                    <i class="fas fa-info-circle me-2"></i>Chưa có đánh giá
                                </div>
                            }
                            else
                            {
                                <blockquote class="blockquote">
                                    <p class="mb-0">
                                        <i class="fas fa-quote-left text-muted me-2"></i>
                                        @Model.Danhgia
                                        <i class="fas fa-quote-right text-muted ms-2"></i>
                                    </p>
                                </blockquote>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0 text-primary">
                                <i class="fas fa-user me-2"></i>Thông tin Người tham gia
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (Model.participant != null)
                            {
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-id-badge me-2"></i>Mã Người tham gia</span>
                                        <strong>@Model.participant.ParticipantID</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-user me-2"></i>Họ và tên</span>
                                        <strong>@Model.participant.FullName</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-building me-2"></i>Câu lạc bộ</span>
                                        <strong>@Model.participant.Club</strong>
                                    </li>
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-warning text-center" role="alert">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Không có thông tin người tham gia
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0 text-primary">
                                <i class="fas fa-futbol me-2"></i>Thông tin Trận đấu
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (Model.match != null)
                            {
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-id-card me-2"></i>Mã Trận đấu</span>
                                        <strong>@Model.match.MatchId</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-calendar-alt me-2"></i>Ngày thi đấu</span>
                                        <strong>@Model.match.Date.ToString("dd/MM/yyyy")</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-map-marker-alt me-2"></i>Địa điểm</span>
                                        <strong>@Model.match.SanDau</strong>
                                    </li>
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-warning text-center" role="alert">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Không có thông tin trận đấu
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a asp-action="Update" asp-route-id="@Model.ScoreId" class="btn btn-warning">
                    <i class="fas fa-edit me-2"></i>Chỉnh sửa
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            
        });
    </script>
}
