@{
    Layout = "~/Views/Shared/Admin_layout.cshtml";
    ViewData["Title"] = "Quản lý Kết quả";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item active text-white">Danh sách Kết Quả</li>
    </ol>
</nav>


<header class="mb-4">
    <div class="vct-page-kicker">Quản lý thi đấu</div>
    <h1 class="vct-page-title">Danh sách kết quả</h1>
    <p class="vct-page-subtitle">Tra cứu, cập nhật và quản lý điểm số của các trận đấu.</p>
</header>

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card vct-panel">
       
        <div class="card-header vct-panel__header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Quản lý Kết quả</h4>
            <button class="vct-btn vct-btn--gold" onclick="location.href='@Url.Action("Add", "KetQua")'">
                <i class="bi bi-plus-lg"></i> Thêm kết quả mới
            </button>
        </div>
       
        <div class="card-body">
            <div class="row align-items-center mb-3">
                <div class="col-lg-7">
                    <form asp-controller="KetQua" asp-action="Index" method="get">
                        <div class="vct-search">
                            <input name="searchString" type="text" class="form-control" placeholder="Tìm kiếm kết quả..."
                                   value="@ViewBag.searchValue">
                            <button class="vct-btn vct-btn--ghost" type="submit"><i class="bi bi-search"></i> Tìm kiếm</button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-5 mt-3 mt-lg-0">
                    @if (!string.IsNullOrEmpty(ViewBag.searchValue))
                    {
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0" style="color: var(--vct-gold-light)">
                                Kết quả tìm kiếm cho: <strong>"@ViewBag.searchValue"</strong>
                            </h6>
                            <a asp-controller="KetQua" asp-action="Index" class="vct-btn vct-btn--ghost ms-3">
                                <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Người tham gia</th>
                            <th>Trận đấu</th>
                            <th>Loại hình thi đấu</th>
                            <th>Mã trận đấu</th>
                            <th>Điểm</th>
                            <th>Kết quả</th>
                            <th>Giải đấu</th>
                            <th class="vct-action-column">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ScoreId</td>
                                <td>@(item.participant?.FullName ?? "N/A")</td>
                                <td>@(item.match?.Vongdau ?? "N/A")</td>
                                <td>@(item.match.LoaiHinhThiDau.Name ?? "N/A")</td>
                                <td>@(item.match?.MatchId ?? "N/A")</td>
                                <td class="vct-mono-value">@item.Diem</td>
                          
                                <td>@item.KietQua</td>
                                <td>@item.participant.Tournament.Name</td>
                                <td class="vct-action-column">
                                    <div class="vct-actions" role="group" aria-label="Thao tác với kết quả @item.ScoreId">
                                        <a asp-action="Display" asp-route-id="@item.ScoreId" class="vct-icon-btn vct-icon-btn--view" title="Xem chi tiết" aria-label="Xem chi tiết kết quả @item.ScoreId"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Update" asp-route-id="@item.ScoreId" class="vct-icon-btn vct-icon-btn--edit" title="Chỉnh sửa" aria-label="Chỉnh sửa kết quả @item.ScoreId"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.ScoreId" class="vct-icon-btn vct-icon-btn--delete" title="Xóa" aria-label="Xóa kết quả @item.ScoreId"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <span>Tổng số: @(ViewBag.TotalCount ?? (Model == null ? 0 : Model.Count)) kết quả</span>
                <a asp-controller="TrangQL" asp-action="Index" class="vct-btn vct-btn--ghost"><i class="bi bi-arrow-left"></i> Quay lại trang quản trị</a>
            </div>
        </div>
    </div>
</div>
