@model BaoCaoDACS.Areas.Admin.Models.ResultAdminIndexViewModel

@{
    Layout = "~/Views/Shared/Admin_layout.cshtml";
    ViewData["Title"] = "Quản lý Kết quả";
    var tournamentGroups = Model.TournamentGroups;
}

@section Styles {
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        .result-tournament-group {
            overflow: hidden;
            border: 1px solid var(--vct-stone);
            border-radius: 14px;
            background: var(--vct-ink-card);
        }

        .result-tournament-group__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border: 0;
            background: rgba(212, 175, 55, .09);
            color: var(--vct-gold-light);
            text-align: left;
            transition: background-color .2s ease;
        }

        .result-tournament-group__header:hover {
            background: rgba(212, 175, 55, .16);
        }

        .result-tournament-group__header:focus-visible {
            outline: 2px solid var(--vct-gold);
            outline-offset: -2px;
        }

        .result-tournament-group__name {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
        }

        .result-tournament-group__chevron {
            transition: transform .2s ease;
        }

        .result-tournament-group__header[aria-expanded="true"] .result-tournament-group__chevron {
            transform: rotate(180deg);
        }

        .result-tournament-group__body {
            border-top: 1px solid var(--vct-stone);
        }

        .result-tournament-group--unassigned {
            border-color: rgba(220, 53, 69, .55);
        }

        .result-tournament-group--unassigned .result-tournament-group__header {
            background: rgba(220, 53, 69, .12);
        }
    </style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a>
        </li>
        <li class="breadcrumb-item active text-white">Danh sách Kết Quả</li>
    </ol>
</nav>

<header class="mb-4">
    <div class="vct-page-kicker">Quản lý thi đấu</div>
    <h1 class="vct-page-title">Danh sách kết quả</h1>
    <p class="vct-page-subtitle">Mở từng giải để tra cứu, cập nhật và quản lý điểm số.</p>
</header>

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card vct-panel">
        <div class="card-header vct-panel__header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Quản lý Kết quả</h4>
            <button class="vct-btn vct-btn--gold" onclick="location.href='@Url.Action("Add", "KetQua")'">
                <i class="bi bi-plus-lg"></i> Thêm kết quả mới
            </button>
        </div>

        <div class="card-body">
            <div class="row align-items-center mb-4">
                <div class="col-lg-7">
                    <form asp-controller="KetQua" asp-action="Index" method="get">
                        <div class="vct-search">
                            <input name="searchString"
                                   type="text"
                                   class="form-control"
                                   placeholder="Tìm theo vận động viên, mã trận hoặc tên giải..."
                                   value="@Model.SearchValue">
                            <button class="vct-btn vct-btn--ghost" type="submit">
                                <i class="bi bi-search"></i> Tìm kiếm
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-5 mt-3 mt-lg-0">
                    @if (!string.IsNullOrEmpty(Model.SearchValue))
                    {
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0" style="color: var(--vct-gold-light)">
                                Kết quả cho: <strong>"@Model.SearchValue"</strong>
                            </h6>
                            <a asp-controller="KetQua" asp-action="Index" class="vct-btn vct-btn--ghost ms-3">
                                <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>

            @if (tournamentGroups.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard-x fs-1 d-block mb-3" style="color: var(--vct-ivory-muted)"></i>
                    <h5>Không tìm thấy kết quả</h5>
                    <p class="mb-0" style="color: var(--vct-ivory-muted)">
                        Hãy thử từ khóa khác hoặc xóa bộ lọc hiện tại.
                    </p>
                </div>
            }
            else
            {
                <div class="d-grid gap-4">
                    @for (var groupIndex = 0; groupIndex < tournamentGroups.Count; groupIndex++)
                    {
                        var group = tournamentGroups[groupIndex];
                        var isUnassigned = group.TournamentId == null;
                        var collapseId = $"results-tournament-{group.TournamentId?.ToString() ?? "unassigned"}";
                        var loadUrl = Url.Action(
                            "TournamentResults",
                            "KetQua",
                            new
                            {
                                tournamentId = group.TournamentId,
                                searchString = Model.SearchValue
                            });

                        <section class="result-tournament-group @(isUnassigned ? "result-tournament-group--unassigned" : "")">
                            <button class="result-tournament-group__header"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                <span class="result-tournament-group__name">
                                    <i class="bi @(isUnassigned ? "bi-exclamation-triangle" : "bi-trophy")"></i>
                                    @group.TournamentName
                                </span>
                                <i class="bi bi-chevron-down result-tournament-group__chevron" aria-hidden="true"></i>
                            </button>

                            <div id="@collapseId"
                                 class="collapse"
                                 data-results-url="@loadUrl"
                                 data-loaded="false">
                                <div class="result-tournament-group__body p-4 text-center"
                                     style="color: var(--vct-ivory-muted)">
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    Đang tải @group.ResultCount kết quả...
                                </div>
                            </div>
                        </section>
                    }
                </div>
            }
        </div>

        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <span>Tổng số: @Model.TotalResults kết quả thuộc @tournamentGroups.Count nhóm giải</span>
                <a asp-controller="TrangQL" asp-action="Index" class="vct-btn vct-btn--ghost">
                    <i class="bi bi-arrow-left"></i> Quay lại trang quản trị
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("[data-results-url]").forEach(panel => {
                panel.addEventListener("show.bs.collapse", async () => {
                    if (panel.dataset.loaded === "true" || panel.dataset.loading === "true") {
                        return;
                    }

                    panel.dataset.loading = "true";

                    try {
                        const response = await fetch(panel.dataset.resultsUrl, {
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}`);
                        }

                        panel.innerHTML = await response.text();
                        panel.dataset.loaded = "true";
                    } catch {
                        panel.innerHTML = `
                            <div class="result-tournament-group__body p-4 text-center text-danger">
                                Không thể tải danh sách kết quả. Hãy đóng nhóm và mở lại để thử lại.
                            </div>`;
                    } finally {
                        panel.dataset.loading = "false";
                    }
                });
            });
        });
    </script>
}
