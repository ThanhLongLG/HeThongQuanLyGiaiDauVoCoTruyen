@model BaoCaoDACS.Areas.Admin.Models.ParticipantAdminDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết người tham gia";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
@if (Model == null)
{
    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        Lỗi: Không tìm thấy thông tin người tham gia!
    </div>
}
else
{
    <div class="container-fluid py-4">
        <nav class="mt-2 mb-4" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active text-white">Danh sách Người Dùng</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header pb-0 bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Chi tiết người tham gia</h6>
                            <a class="btn btn-light btn-sm" asp-action="Index">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mx-auto">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <tbody>
                                            <tr>
                                                <th class="text-primary" style="width: 40%;">Mã người tham gia</th>
                                                <td>@Model.Participant.ParticipantID</td>
                                            </tr>
                                            <tr>
                                                <th class="text-primary">Họ và tên</th>
                                                <td>@Model.Participant.FullName</td>
                                            </tr>
                                            <tr>
                                                <th class="text-primary">Câu lạc bộ</th>
                                                <td>@Model.Participant.Club</td>
                                            </tr>
                                            
                                            @if (Model.Participant.sdt != null)
                                            {
                                                <tr>
                                                    <th class="text-primary">Số điện thoại</th>
                                                    <td>@Model.Participant.sdt</td>
                                                </tr>
                                            }
                                            @if (Model.Participant.email != null)
                                            {
                                                <tr>
                                                    <th class="text-primary">Email</th>
                                                    <td>@Model.Participant.email</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <hr class="my-4" />
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Điểm ranking theo giải đấu</h6>
                            <a class="btn btn-primary btn-sm"
                               asp-action="Update"
                               asp-route-id="@Model.Participant.ParticipantID">
                                <i class="bi bi-pencil me-1"></i> Chỉnh sửa ranking
                            </a>
                        </div>

                        @if (Model.Rankings.Count == 0)
                        {
                            <div class="alert alert-info mb-0">
                                Người tham gia này chưa có dữ liệu ranking.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Giải đấu</th>
                                            <th>Điểm</th>
                                            <th>Hạng</th>
                                            <th>Số trận</th>
                                            <th>Thắng</th>
                                            <th>Thua</th>
                                            <th>Cập nhật</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ranking in Model.Rankings)
                                        {
                                            var tierName = ranking.Tier switch
                                            {
                                                0 => "Đồng",
                                                1 => "Bạc",
                                                2 => "Vàng",
                                                3 => "Bạch kim",
                                                _ => "Không xác định"
                                            };
                                            <tr>
                                                <td>@ranking.TournamentName</td>
                                                <td class="vct-mono-value fw-bold">@ranking.Rating.ToString("0.##")</td>
                                                <td>@tierName</td>
                                                <td>@ranking.MatchesPlayed</td>
                                                <td>@ranking.Wins</td>
                                                <td>@ranking.Losses</td>
                                                <td>@ranking.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
}
