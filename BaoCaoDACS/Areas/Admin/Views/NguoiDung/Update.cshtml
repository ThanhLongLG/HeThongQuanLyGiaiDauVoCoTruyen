@model BaoCaoDACS.Areas.Admin.Models.ParticipantAdminDetailsViewModel
@{
    ViewData["Title"] = "Cập nhật thông tin người tham gia";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<div class="container-fluid py-4">
    <nav class="mt-2 mb-4" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active text-white">Danh sách Người Dùng</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header pb-0 bg-primary text-white">
            <h5 class="mb-0">Cập nhật thông tin người tham gia</h5>
        </div>
        <div class="card-body">
            <form asp-action="Update" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Hidden field for ParticipantID -->
                <input type="hidden" asp-for="Participant.ParticipantID" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.FullName" class="form-label">Họ và tên</label>
                            <input asp-for="Participant.FullName" class="form-control" required />
                            <div class="invalid-feedback">Vui lòng nhập họ và tên.</div>
                            <span asp-validation-for="Participant.FullName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.Club" class="form-label">Câu lạc bộ</label>
                            <input asp-for="Participant.Club" class="form-control" required />
                            <div class="invalid-feedback">Vui lòng nhập tên câu lạc bộ.</div>
                            <span asp-validation-for="Participant.Club" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.sdt" class="form-label">Số điện thoại</label>
                            <input asp-for="Participant.sdt" class="form-control" required />
                            <div class="invalid-feedback">Vui lòng Số Điện thoại.</div>
                            <span asp-validation-for="Participant.sdt" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Participant.TournamentID" class="form-label">Giải đấu</label>
                        <select asp-for="Participant.TournamentID" class="form-select" asp-items="ViewBag.Tournaments">
                            <option value="">-- Không tham gia giải đấu nào --</option>
                        </select>
                        <div class="form-text">Chọn giải đấu mà người dùng tham gia, hoặc để trống nếu không tham gia giải đấu nào.</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.email" class="form-label">Email</label>
                            <input asp-for="Participant.email" class="form-control" required />
                            <div class="invalid-feedback">Vui lòng nhập Email.</div>
                            <span asp-validation-for="Participant.email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.ChieuCao" class="control-label">Chiều cao</label>
                            <input asp-for="Participant.ChieuCao" class="form-control" type="number" step="0.01" placeholder="Nhập chiều cao" />
                            <span asp-validation-for="Participant.ChieuCao" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.CanNang" class="control-label">Cân nặng</label>
                            <input asp-for="Participant.CanNang" class="form-control" type="number" step="0.01" placeholder="Nhập cân nặng" />
                            <span asp-validation-for="Participant.CanNang" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.tuoi" class="control-label">Tuổi</label>
                            <input asp-for="Participant.tuoi" class="form-control" type="number" placeholder="Nhập tuổi" />
                            <span asp-validation-for="Participant.tuoi" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Participant.Diachi" class="control-label">Địa chỉ</label>
                            <input asp-for="Participant.Diachi" class="form-control" placeholder="Nhập địa chỉ" />
                            <span asp-validation-for="Participant.Diachi" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                <h5 class="mb-3">Điểm ranking theo giải đấu</h5>

                @if (Model.Rankings.Count == 0)
                {
                    <div class="alert alert-info">
                        Người tham gia này chưa có dữ liệu ranking để chỉnh sửa.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Giải đấu</th>
                                    <th style="min-width: 160px;">Điểm ranking</th>
                                    <th>Hạng hiện tại</th>
                                    <th>Thành tích</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Rankings.Count; i++)
                                {
                                    var ranking = Model.Rankings[i];
                                    var tierName = ranking.Tier switch
                                    {
                                        0 => "Đồng",
                                        1 => "Bạc",
                                        2 => "Vàng",
                                        3 => "Bạch kim",
                                        _ => "Không xác định"
                                    };
                                    <tr>
                                        <td>
                                            @ranking.TournamentName
                                            <input type="hidden" asp-for="Rankings[i].Id" />
                                        </td>
                                        <td>
                                            <input asp-for="Rankings[i].Rating"
                                                   class="form-control"
                                                   type="number"
                                                   min="0"
                                                   max="5000"
                                                   step="0.01" />
                                            <span asp-validation-for="Rankings[i].Rating" class="text-danger"></span>
                                        </td>
                                        <td>@tierName</td>
                                        <td>
                                            @ranking.MatchesPlayed trận —
                                            @ranking.Wins thắng / @ranking.Losses thua
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text mb-3">
                        Hạng sẽ được tính lại tự động khi lưu điểm ranking.
                    </div>
                }

                <div class="d-flex justify-content-start gap-3 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i> Lưu thay đổi
                    </button>
                    <a class="btn btn-secondary" asp-action="Index">
                        <i class="fas fa-arrow-left me-2"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Bootstrap 5 validation
        (() => {
            'use strict'

            // Fetch all the forms we want to apply custom validation styles to
            const forms = document.querySelectorAll('.needs-validation')

            // Loop over them and prevent submission
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }

                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
