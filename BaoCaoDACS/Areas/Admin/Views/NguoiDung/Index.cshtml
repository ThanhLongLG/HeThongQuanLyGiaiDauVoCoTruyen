@{
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}


<head>
	<link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<title>@ViewData["Title"] Admin</title>
	<link href="~/css/admin.css" rel="stylesheet" />
</head>
<nav class="mt-2 mb-4" aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-area="Admin" asp-controller="TrangQL" asp-action="Index">TrangChu</a></li>
        <li class="breadcrumb-item"><a class=" text-white text-decoration-none" asp-area="Admin" asp-action="Index">Danh Sách Khach Hang</a></li>
  
    </ol>
</nav>

<div class="container-fluid mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Quản lý Người dùng</h4>
            <button class="btn btn-light" onclick="location.href='@Url.Action("Add", "NguoiDung")'">
                <i class="bi bi-plus-circle me-2"></i> Thêm người tham gia
            </button>
        </div>
        <div class="card-body">
            <div class="row align-items-center mb-3">
                <div class="col-md-5">
                    <form asp-controller="NguoiDung" asp-action="Index" method="get">
                        <div class="input-group">
                            <input name="searchValue" type="text" class="form-control my-input" placeholder="Bạn muốn tìm gì ?"
                                   value="@ViewBag.searchValue">
                            <button class="btn btn-primary my-button" type="submit">Tìm kiếm</button>
                        </div>
                    </form>
                </div>
                <div class="col-md-7">
                    @if (!string.IsNullOrEmpty(ViewBag.searchValue))
                    {
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0 text-primary">
                                Kết quả tìm kiếm cho: <strong>"@ViewBag.searchValue"</strong>
                            </h6>
                            <a asp-controller="NguoiDung" asp-action="Index" class="btn btn-sm btn-outline-secondary ms-3">
                                <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover border">
                    <thead class="table-dark">
                <thead>
                    <tr class="text-white">
                        <th>Ten</th>
                        <th>Club</th>
                      
                        <th>SDT</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="text-light">
                    @foreach (var item in Model)
                    {
                        <tr>
                     
                            <td>@item.FullName</td>
                            <td>@item.Club</td>
                            <th>@item.sdt</th>
                            <th>@item.email</th>
                            <td>
                                <a asp-action="Display" asp-route-id="@item.ParticipantID" class="btn btn-info">Chi tiết</a>
                                <a asp-action="Update" asp-route-id="@item.ParticipantID" class="btn btn-primary">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.ParticipantID" class="btn btn-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        </div>
    </div>


