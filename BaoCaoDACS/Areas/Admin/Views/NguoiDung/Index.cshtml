@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}


<head>
	<link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<title>@ViewData["Title"] Admin</title>
	<link href="~/css/admin.css" rel="stylesheet" />
</head>
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-area="Admin" asp-controller="TrangQL" asp-action="Index">TrangChu</a></li>
        <li class="breadcrumb-item"><a class=" text-white text-decoration-none" asp-area="Admin" asp-action="Index">Danh Sách Khach Hang</a></li>
  
    </ol>
</nav>

<header class="mb-4">
    <div class="vct-page-kicker">Quản lý hệ thống</div>
    <h1 class="vct-page-title">Danh sách người dùng</h1>
    <p class="vct-page-subtitle">Theo dõi và cập nhật thông tin võ sinh tham gia các giải đấu.</p>
</header>

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="card vct-panel">
        <div class="card-header vct-panel__header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Quản lý Người dùng</h4>
            <button class="vct-btn vct-btn--gold" onclick="location.href='@Url.Action("Add", "NguoiDung")'">
                <i class="bi bi-plus-lg"></i> Thêm người tham gia
            </button>
        </div>
        <div class="card-body">
            <div class="row align-items-center mb-3">
                <div class="col-lg-7">
                    <form asp-controller="NguoiDung" asp-action="Index" method="get">
                        <div class="vct-search">
                            <input name="searchValue" type="text" class="form-control" placeholder="Tìm kiếm người dùng..."
                                   value="@ViewBag.searchValue">
                            <button class="vct-btn vct-btn--ghost" type="submit"><i class="bi bi-search"></i> Tìm kiếm</button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-5 mt-3 mt-lg-0">
                    @if (!string.IsNullOrEmpty(ViewBag.searchValue))
                    {
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0" style="color: var(--vct-gold-light)">
                                Kết quả tìm kiếm cho: <strong>"@ViewBag.searchValue"</strong>
                            </h6>
                            <a asp-controller="NguoiDung" asp-action="Index" class="vct-btn vct-btn--ghost ms-3">
                                <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Câu lạc bộ</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th class="vct-action-column">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                     
                            <td>@item.FullName</td>
                            <td>@item.Club</td>
                            <td class="vct-mono-value">@item.sdt</td>
                            <td>@item.email</td>
                            <td class="vct-action-column">
                                <div class="vct-actions" role="group" aria-label="Thao tác với @item.FullName">
                                    <a asp-action="Display" asp-route-id="@item.ParticipantID" class="vct-icon-btn vct-icon-btn--view" title="Xem chi tiết" aria-label="Xem chi tiết @item.FullName"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Update" asp-route-id="@item.ParticipantID" class="vct-icon-btn vct-icon-btn--edit" title="Chỉnh sửa" aria-label="Chỉnh sửa @item.FullName"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.ParticipantID" class="vct-icon-btn vct-icon-btn--delete" title="Xóa" aria-label="Xóa @item.FullName"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <span>Tổng số: @(Model == null ? 0 : Model.Count) người dùng</span>
                <a asp-controller="TrangQL" asp-action="Index" class="vct-btn vct-btn--ghost"><i class="bi bi-arrow-left"></i> Quay lại trang quản trị</a>
            </div>
        </div>
    </div>


