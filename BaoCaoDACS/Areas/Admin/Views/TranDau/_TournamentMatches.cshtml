@model IReadOnlyList<BaoCaoDACS.Models.Match>

@if (Model.Count == 0)
{
    <div class="p-4 text-center" style="color: var(--vct-ivory-muted)">
        Không có trận đấu trong nhóm này.
    </div>
}
else
{
    <div class="table-responsive match-tournament-group__body">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Mã trận</th>
                    <th>Vòng đấu</th>
                    <th>Loại hình</th>
                    <th>Hạng cân</th>
                    <th>Sân đấu</th>
                    <th>Trọng tài</th>
                    <th>Ngày giờ thi đấu</th>
                    <th>Trạng thái</th>
                    <th class="vct-action-column">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.MatchId</strong></td>
                        <td>@item.Vongdau</td>
                        <td>@(item.LoaiHinhThiDau?.Name ?? "N/A")</td>
                        <td>@item.Hangcan</td>
                        <td>@item.SanDau</td>
                        <td>@item.Trongtai</td>
                        <td>@item.Date.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.trangthai == 1)
                            {
                                <span class="match-status match-status--done">
                                    <i class="bi bi-check-circle-fill"></i> Đã chấm
                                </span>
                            }
                            else
                            {
                                <span class="match-status match-status--pending">
                                    <i class="bi bi-clock-fill"></i> Chưa chấm
                                </span>
                            }
                        </td>
                        <td class="vct-action-column">
                            <div class="vct-actions" role="group" aria-label="Thao tác với trận @item.MatchId">
                                <a asp-action="Display" asp-route-id="@item.MatchId" class="vct-icon-btn vct-icon-btn--view" title="Xem chi tiết" aria-label="Xem chi tiết trận @item.MatchId"><i class="bi bi-eye"></i></a>
                                <a asp-action="Update" asp-route-id="@item.MatchId" class="vct-icon-btn vct-icon-btn--edit" title="Chỉnh sửa" aria-label="Chỉnh sửa trận @item.MatchId"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.MatchId" class="vct-icon-btn vct-icon-btn--delete" title="Xóa" aria-label="Xóa trận @item.MatchId"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
