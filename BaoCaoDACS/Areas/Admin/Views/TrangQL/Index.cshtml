@{
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}


<h3 class="mt-2 mb-4">DASHBOARD</h3>

<h2 class="mb-4">📊 Thống kê</h2>


<div class="row g-4">
    <div class="col-sm-12 col-md-6 col-lg-4">
        <div class="card bg-primary text-white shadow-lg rounded-3">
            <div class="card-body text-center">
                <h4 class="fw-bold">👥 Người Dùng</h4>
                <p class="fs-1 fw-bold mb-2">@ViewBag.khachhangcount người</p>
                <hr class="border-light" />
                <a class="text-white text-decoration-none fw-semibold" asp-controller="NguoiDung" asp-action="Index">Xem chi tiết →</a>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-md-6 col-lg-4">
        <div class="card bg-success text-white shadow-lg rounded-3">
            <div class="card-body text-center">
                <h4 class="fw-bold">Giải Đấu</h4>
                <p class="fs-1 fw-bold mb-2">@ViewBag.Giadaucount giải đấu</p>
                <hr class="border-light" />
                <a class="text-white text-decoration-none fw-semibold" asp-controller="GiaiDau" asp-action="Index">Xem chi tiết →</a>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-md-6 col-lg-4">
        <div class="card bg-secondary text-white shadow-lg rounded-3">
            <div class="card-body text-center">
                <h4 class="fw-bold"><span class="glyphicon glyphicon-briefcase"></span>Trận Đấu</h4>
                <p class="fs-1 fw-bold mb-2">@ViewBag.trandaucount trận đấu</p>
                <hr class="border-light" />
                <a class="text-white text-decoration-none fw-semibold" asp-controller="TranDau" asp-action="Index">Xem chi tiết →</a>
            </div>
        </div>
    </div>
   
</div>


